-
	if (typeof locale === 'undefined') {
		locale = 'es'
	}

	var reviewsTemplateId = '5X_7R5TK0rM'
	var reviewsTemplateThumb = 'https://i.ytimg.com/vi/' + reviewsTemplateId + '/hqdefault.jpg'
	var reviewsTemplateEmbed = 'https://www.youtube.com/embed/' + reviewsTemplateId
	var reviewsTemplateWatch = 'https://www.youtube.com/shorts/' + reviewsTemplateId

	var reviewsVideos = [
		{
			id: reviewsTemplateId,
			categories: ['artist'],
			thumb: reviewsTemplateThumb,
			embedUrl: reviewsTemplateEmbed,
			watchUrl: reviewsTemplateWatch,
			name: { es: 'Testimonio artista 1', en: 'Artist testimonial 1' },
			sample: true
		},
		{
			id: reviewsTemplateId,
			categories: ['artist', 'teacher'],
			thumb: reviewsTemplateThumb,
			embedUrl: reviewsTemplateEmbed,
			watchUrl: reviewsTemplateWatch,
			name: { es: 'Testimonio artista y profesor', en: 'Artist and teacher testimonial' },
			sample: true
		},
		{
			id: reviewsTemplateId,
			categories: ['teacher'],
			thumb: reviewsTemplateThumb,
			embedUrl: reviewsTemplateEmbed,
			watchUrl: reviewsTemplateWatch,
			name: { es: 'Testimonio profesor 1', en: 'Teacher testimonial 1' },
			sample: true
		},
		{
			id: reviewsTemplateId,
			categories: ['producer'],
			thumb: reviewsTemplateThumb,
			embedUrl: reviewsTemplateEmbed,
			watchUrl: reviewsTemplateWatch,
			name: { es: 'Testimonio productor 1', en: 'Producer testimonial 1' },
			sample: true
		},
		{
			id: reviewsTemplateId,
			categories: ['artist', 'teacher', 'producer'],
			thumb: reviewsTemplateThumb,
			embedUrl: reviewsTemplateEmbed,
			watchUrl: reviewsTemplateWatch,
			name: { es: 'Testimonio en las tres áreas', en: 'All three areas testimonial' },
			sample: true
		},
		{
			id: reviewsTemplateId,
			categories: ['artist', 'producer'],
			thumb: reviewsTemplateThumb,
			embedUrl: reviewsTemplateEmbed,
			watchUrl: reviewsTemplateWatch,
			name: { es: 'Testimonio artista y productor', en: 'Artist and producer testimonial' },
			sample: true
		}
	]

	var reviewsContent = {
		es: {
			id: 'resenas',
			title: 'Testimonios',
			lead: 'Voces reales grabadas en celular. Filtra por área y escucha cómo se vive trabajar con Kike como artista, profesor o productor. Un mismo video puede aparecer en más de un filtro. Los videos actuales son una plantilla hasta publicar los testimonios oficiales.',
			filterLabel: 'Filtrar testimonios',
			filtersPrevLabel: 'Filtros anteriores',
			filtersNextLabel: 'Filtros siguientes',
			playLabel: 'Reproducir testimonio',
			externalLabel: 'Ver en YouTube',
			prevLabel: 'Testimonio anterior',
			nextLabel: 'Testimonio siguiente',
			defaultFilter: 'artist',
			filters: [
				{ key: 'artist', label: 'Artista' },
				{ key: 'teacher', label: 'Profesor' },
				{ key: 'producer', label: 'Productor' }
			]
		},
		en: {
			id: 'reviews',
			title: 'Testimonials',
			lead: 'Real voices recorded on a phone. Filter by area and hear what it is like to work with Kike as an artist, teacher, or producer. The same video can appear in more than one filter. The current videos are a template until the official testimonials go live.',
			filterLabel: 'Filter testimonials',
			filtersPrevLabel: 'Previous filters',
			filtersNextLabel: 'Next filters',
			playLabel: 'Play testimonial',
			externalLabel: 'Watch on YouTube',
			prevLabel: 'Previous testimonial',
			nextLabel: 'Next testimonial',
			defaultFilter: 'artist',
			filters: [
				{ key: 'artist', label: 'Artist' },
				{ key: 'teacher', label: 'Teacher' },
				{ key: 'producer', label: 'Producer' }
			]
		}
	}

	var reviewsLocale = reviewsContent[locale] || reviewsContent.es

	reviewsLocale.items = reviewsVideos.map(function (item) {
		var categories = Array.isArray(item.categories)
			? item.categories
			: item.category
				? [item.category]
				: []

		return {
			id: item.id,
			categories: categories,
			categoriesAttr: categories.join(' '),
			thumb: item.thumb,
			embedUrl: item.embedUrl,
			watchUrl: item.watchUrl,
			name: item.name[locale] || item.name.es,
			sample: !!item.sample
		}
	})

	var reviewsData = reviewsLocale
