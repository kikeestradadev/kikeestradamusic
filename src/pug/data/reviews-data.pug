-
	if (typeof locale === 'undefined') {
		locale = 'es'
	}

	// Añade testimonios con id de YouTube y categories: artist, teacher, producer.
	var reviewsVideos = [
		{
			id: '9K3e7ETaivo',
			categories: ['artist', 'teacher'],
			name: 'Alejandra François',
			project: 'W-Arts'
		}
	]

	var reviewsContent = {
		es: {
			id: 'resenas',
			title: 'Testimonios',
			lead: 'Voces reales grabadas en celular. Filtra por área y escucha cómo se vive trabajar con Kike como artista, profesor o productor. Un mismo video puede aparecer en más de un filtro.',
			filterLabel: 'Filtrar testimonios',
			filtersPrevLabel: 'Filtros anteriores',
			filtersNextLabel: 'Filtros siguientes',
			playLabel: 'Reproducir testimonio',
			externalLabel: 'Ver en YouTube',
			prevLabel: 'Testimonio anterior',
			nextLabel: 'Testimonio siguiente',
			defaultFilter: 'artist',
			filters: [
				{ key: 'artist', label: 'Artista' },
				{ key: 'teacher', label: 'Profesor' },
				{ key: 'producer', label: 'Productor' }
			]
		},
		en: {
			id: 'reviews',
			title: 'Testimonials',
			lead: 'Real voices recorded on a phone. Filter by area and hear what it is like to work with Kike as an artist, teacher, or producer. The same video can appear in more than one filter.',
			filterLabel: 'Filter testimonials',
			filtersPrevLabel: 'Previous filters',
			filtersNextLabel: 'Next filters',
			playLabel: 'Play testimonial',
			externalLabel: 'Watch on YouTube',
			prevLabel: 'Previous testimonial',
			nextLabel: 'Next testimonial',
			defaultFilter: 'artist',
			filters: [
				{ key: 'artist', label: 'Artist' },
				{ key: 'teacher', label: 'Teacher' },
				{ key: 'producer', label: 'Producer' }
			]
		}
	}

	var reviewsLocale = reviewsContent[locale] || reviewsContent.es

	reviewsLocale.items = reviewsVideos.map(function (item) {
		var categories = Array.isArray(item.categories)
			? item.categories
			: item.category
				? [item.category]
				: []

		var id = item.id
		var name = typeof item.name === 'object'
			? (item.name[locale] || item.name.es)
			: (item.name || '')
		var project = typeof item.project === 'object'
			? (item.project[locale] || item.project.es)
			: (item.project || '')
		var title = [name, project].filter(Boolean).join(', ')

		return {
			id: id,
			categories: categories,
			categoriesAttr: categories.join(' '),
			thumb: item.thumb || ('https://i.ytimg.com/vi/' + id + '/hqdefault.jpg'),
			embedUrl: item.embedUrl || ('https://www.youtube.com/embed/' + id),
			watchUrl: item.watchUrl || ('https://www.youtube.com/shorts/' + id),
			name: name,
			project: project,
			title: title
		}
	})

	var reviewsData = reviewsLocale
