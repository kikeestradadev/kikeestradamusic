	var mapProduceVideos = function (items, copy) {
		return items.map(function (item) {
			var startQuery = item.start ? '?start=' + item.start : ''
			var watchTime = item.start ? '&t=' + item.start + 's' : ''
			var title = pickLocale(item.title)
			var artist = pickLocale(item.artist)
			var role = item.rolePending
				? copy.rolePlaceholder
				: (pickLocale(item.role) || copy.defaultRole)
			var roleShort = item.rolePending
				? ''
				: (pickLocale(item.roleShort) || copy.defaultRoleShort || role)
			var workType = copy.workTypes[item.workTypeKey] || ''
			var artistKind = item.artistKind || 'artist'
			var captionParts = [title, artist, workType].filter(Boolean)
			var filterKeys = Array.isArray(item.filterKeys)
				? item.filterKeys.filter(Boolean)
				: item.filterKey
					? [item.filterKey]
					: []

			return {
				id: item.id,
				filterKeys: filterKeys,
				filterKey: filterKeys[0] || 'all',
				categoriesAttr: filterKeys.join(' '),
				title: title,
				artist: artist,
				artistLabel: copy.creditLabels[artistKind] || copy.creditLabels.artist,
				role: role,
				roleShort: roleShort,
				rolePending: !!item.rolePending,
				roleLabel: copy.creditLabels.role,
				workType: workType,
				workTypeLabel: copy.creditLabels.workType,
				caption: captionParts.join(' · '),
				thumb: 'https://i.ytimg.com/vi/' + item.id + '/hqdefault.jpg',
				embedUrl: 'https://www.youtube.com/embed/' + item.id + startQuery,
				watchUrl: 'https://www.youtube.com/watch?v=' + item.id + watchTime
			}
		})
	}

