	var mapProduceVideos = function (items, copy) {
		return items.map(function (item) {
			var startQuery = item.start ? '?start=' + item.start : ''
			var watchTime = item.start ? '&t=' + item.start + 's' : ''

			return {
				id: item.id,
				filterKey: item.filterKey,
				title: copy.titles[item.titleKey] || copy.titles.production,
				category: copy.categories[item.categoryKey] || '',
				thumb: 'https://i.ytimg.com/vi/' + item.id + '/hqdefault.jpg',
				embedUrl: 'https://www.youtube.com/embed/' + item.id + startQuery,
				watchUrl: 'https://www.youtube.com/watch?v=' + item.id + watchTime
			}
		})
	}

