include ../data/contact-data

section(class='contact' id=contactData.id)
	div(class='container contact__container')
		header(class='section-intro contact__intro')
			h2(class='section-intro__title')= contactData.title
			span(class='section-intro__line')
			if contactData.lead
				p(class='section-intro__lead')= contactData.lead
		a(
			class='btn btn--primary contact__cta'
			href=contactData.primaryCta.href
			target='_blank'
			rel='noopener noreferrer'
		)= contactData.primaryCta.label
		p(class='contact__alternatives-label')= contactData.alternativesLabel
		ul(class='contact__alternatives')
			each item in contactData.alternatives
				li(class='contact__alternative')
					a(
						class=`contact__link contact__link--${item.type}`
						href=item.href
						target=(item.type === 'email' ? false : '_blank')
						rel=(item.type === 'email' ? false : 'noopener noreferrer')
					)= item.label
