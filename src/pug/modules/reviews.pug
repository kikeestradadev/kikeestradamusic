include ../data/reviews-data
include slider-nav

section(class='reviews reveal' id=reviewsData.id)
	div(class='container reviews__container')
		header(class='section-intro reviews__intro')
			h2(class='section-intro__title')= reviewsData.title
			span(class='section-intro__line')
			if reviewsData.lead
				p(class='section-intro__lead')= reviewsData.lead
		div(class='reviews__slider swiper')
			ul(class='reviews__list swiper-wrapper')
				each item in reviewsData.items
					li(class='reviews__item swiper-slide')
						figure(class='reviews__card')
							if item.sample
								span(class='reviews__badge')= reviewsData.sampleLabel
							blockquote(class='reviews__quote')
								p(class='reviews__text')= item.quote
							figcaption(class='reviews__meta')
								span(class='reviews__name')= item.name
								span(class='reviews__context')= item.context
			+sliderNavButton({
				className: 'reviews__nav reviews__nav--prev',
				label: reviewsData.prevLabel,
				dir: 'prev'
			})
			+sliderNavButton({
				className: 'reviews__nav reviews__nav--next',
				label: reviewsData.nextLabel,
				dir: 'next'
			})
		div(class='reviews__pagination swiper-pagination')
