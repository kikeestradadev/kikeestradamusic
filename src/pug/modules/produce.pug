include ../data/produce-data
include thumbs-gallery
include slider-nav

section(class='produce reveal' id=produceData.id)
	div(class='container produce__container')
		div(class='produce__layout')
			div(class='produce__content')
				p(class='produce__eyebrow')= produceData.eyebrow
				header(class='section-intro section-intro--left produce__intro')
					h2(class='section-intro__title')= produceData.title
					span(class='section-intro__line')
					if produceData.lead
						p(class='section-intro__lead')= produceData.lead
				ul(class='produce__services')
					each service in produceData.services
						li(class='produce__service')
							article(class='produce__card')
								h3(class='produce__card-title')= service.title
								p(class='produce__card-text')= service.text
			div(class='produce__media')
				div(class='produce__photo')
					+thumbsGallery({
						label: produceData.galleryLabel,
						caption: produceData.galleryCaption,
						prevLabel: produceData.galleryPrevLabel,
						nextLabel: produceData.galleryNextLabel,
						items: produceData.gallery
					})
		div(class='produce__portfolio')
			header(class='produce__portfolio-intro')
				h3(class='produce__portfolio-title')= produceData.portfolioTitle
				if produceData.portfolioLead
					p(class='produce__portfolio-lead')= produceData.portfolioLead
			if produceData.filters && produceData.filters.length
				div(class='produce__filters-shell' aria-label=produceData.filterLabel)
					+sliderNavButton({
						className: 'produce__filters-nav produce__filters-nav--prev',
						label: produceData.filtersPrevLabel,
						dir: 'prev'
					})
					div(class='produce__filters swiper')
						div(class='produce__filters-track swiper-wrapper')
							each filter in produceData.filters
								div(class='produce__filters-slide swiper-slide')
									button(
										class=`produce__filter${filter.key === produceData.defaultFilter ? ' is-active' : ''}`
										type='button'
										data-produce-filter=filter.key
										aria-pressed=(filter.key === produceData.defaultFilter ? 'true' : 'false')
									)= filter.label
					+sliderNavButton({
						className: 'produce__filters-nav produce__filters-nav--next',
						label: produceData.filtersNextLabel,
						dir: 'next'
					})
			div(class='produce__slider swiper')
				ul(class='produce__grid swiper-wrapper')
					each item in produceData.items
						li(
							class='produce__item swiper-slide'
							data-produce-category=item.filterKey
						)
							article(class='produce__video')
								button(
									class='produce__play'
									type='button'
									data-produce-embed=item.embedUrl
									data-produce-title=item.title
									data-produce-watch=item.watchUrl
									aria-haspopup='dialog'
									aria-controls='produce-dialog'
									aria-label=`${produceData.playLabel}: ${item.title}`
								)
									img(
										class='produce__thumb'
										src=item.thumb
										alt=''
										loading='lazy'
										decoding='async'
									)
									span(class='produce__play-icon' aria-hidden='true')
								div(class='produce__meta')
									p(class='produce__category')= item.category
									h4(class='produce__video-title')= item.title
				+sliderNavButton({
					className: 'produce__nav produce__nav--prev',
					label: produceData.prevLabel,
					dir: 'prev'
				})
				+sliderNavButton({
					className: 'produce__nav produce__nav--next',
					label: produceData.nextLabel,
					dir: 'next'
				})
			div(class='produce__pagination swiper-pagination')
			if produceData.cta
				a(class='btn btn--outline produce__cta' href=produceData.cta.href)= produceData.cta.label
	dialog(
		class='produce__dialog'
		id='produce-dialog'
		aria-label=produceData.dialogLabel
	)
		div(class='produce__dialog-shell')
			button(
				class='produce__dialog-close'
				type='button'
				data-produce-close
				aria-label=produceData.closeLabel
			) ×
			div(class='produce__dialog-frame' data-produce-frame)
			p(class='produce__dialog-caption' data-produce-caption)
			a(
				class='produce__dialog-link'
				data-produce-external
				href='#'
				target='_blank'
				rel='noopener noreferrer'
			)= produceData.openOnYoutubeLabel
